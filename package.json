{
  "name": "@gravity-ui/onboarding",
  "version": "1.12.1",
  "description": "",
  "license": "MIT",
  "main": "dist/index.js",
  "files": [
    "dist",
    "dist/plugins"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gravity-ui/onboarding.git"
  },
  "bugs": {
    "url": "https://github.com/gravity-ui/onboarding/issues"
  },
  "homepage": "https://github.com/gravity-ui/onboarding#readme",
  "scripts": {
    "prepare": "husky install",
    "lint:js": "eslint .",
    "lint": "npm run lint:js",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --project tsconfig.test.json",
    "test": "npm run typecheck:tests && vitest run && npm run size",
    "test:coverage": "npm run typecheck:tests && vitest run --coverage && npm run size",
    "test-watch": "vitest --typecheck",
    "build": "node -e \"require('node:fs').rmSync('dist', {recursive: true, force: true})\" && tsc",
    "size": "size-limit",
    "prepublishOnly": "npm run build",
    "force-release": "echo 43"
  },
  "dependencies": {
    "dayjs": "^1.11.21"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^10.0.1",
    "@gravity-ui/prettier-config": "^1.1.1",
    "@gravity-ui/tsconfig": "^1.0.0",
    "@size-limit/esbuild-why": "^12.1.0",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^64.3.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.4.0",
    "husky": "^8.0.3",
    "jsdom": "^30.0.1",
    "nano-staged": "^1.0.2",
    "prettier": "^3.9.6",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "size-limit": "^12.1.0",
    "typescript": "^5.8.3",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "nano-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --quiet"
    ],
    "*.md": [
      "prettier --write"
    ]
  }
}
